{
  "ConnectionStrings": {
    "Database": ""
  },
  "Supabase": {
    "Url": "",
    "PublicUrl": "",
    "SecretKey": "",
    "JwtSecret": "",
    "JwtAudience": "authenticated"
  },
  "Geocoding": {
    "Provider": "photon",
    "UserAgent": "MockGPS-LocationSimulation/1.0"
  },
  "Map": {
    "StyleLightUrl": "https://tiles.openfreemap.org/styles/liberty",
    "StyleDarkUrl": "https://tiles.openfreemap.org/styles/dark",
    "StyleMinimalUrl": "https://tiles.openfreemap.org/styles/positron"
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Swagger": {
    "Enabled": false
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact" } },
      { "Name": "File", "Args": { "path": "logs/api-.log", "rollingInterval": "Day", "retainedFileCountLimit": 14,
        "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact" } }
    ]
  },
  "AllowedHosts": "*"
}
