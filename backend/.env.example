# Backend environment variables (ASP.NET Core uses "__" as section separator).
# Local development: prefer `dotnet user-secrets` in src/MockGps.API (see README).

ASPNETCORE_ENVIRONMENT=Production

# Supabase Postgres. Use the direct connection or the Supavisor SESSION pooler (port 5432),
# not the transaction pooler: RLS scoping uses transaction-local settings.
ConnectionStrings__Database=Host=db.<project-ref>.supabase.co;Port=5432;Database=postgres;Username=postgres;Password=<password>;SSL Mode=Require

Supabase__Url=https://<project-ref>.supabase.co
# Optional, when clients must reach Supabase on a different URL than the backend does.
Supabase__PublicUrl=
# Secret key (sb_secret_...) or legacy service_role key. NEVER put this in mobile/web apps.
Supabase__SecretKey=
# Only for legacy HS256 projects / local CLI. New projects use asymmetric keys via JWKS.
Supabase__JwtSecret=

Geocoding__Provider=photon
Geocoding__MapTilerKey=
Geocoding__UserAgent=MockGPS-LocationSimulation/1.0

Map__StyleLightUrl=https://tiles.openfreemap.org/styles/liberty
Map__StyleDarkUrl=https://tiles.openfreemap.org/styles/dark
Map__StyleSatelliteUrl=

Cors__AllowedOrigins__0=https://mockgps.example.com
Cors__AllowedOrigins__1=https://admin.mockgps.example.com

Swagger__Enabled=false
